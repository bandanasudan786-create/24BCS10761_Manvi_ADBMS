SELECT MIN(Start_Date), MAX(End_Date)
FROM (
    SELECT Start_Date, End_Date,
           SUM(CASE
                   WHEN Start_Date = Prev_End THEN 0
                   ELSE 1
               END) OVER (ORDER BY Start_Date) grp
    FROM (
        SELECT Start_Date, End_Date,
               LAG(End_Date) OVER (ORDER BY Start_Date) Prev_End
        FROM Projects
    ) t
) p
GROUP BY grp
ORDER BY DAYS(MAX(End_Date)) - DAYS(MIN(Start_Date)), MIN(Start_Date);

